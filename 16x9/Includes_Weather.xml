	<include name="WeatherInfoLabel">
		<param name="left" default="1260" />
		<param name="top" default="80" />
		<definition>
			<control type="grouplist">
				<left>$PARAM[left]</left>
				<top>$PARAM[top]</top>
				<width>300</width>
				<orientation>horizontal</orientation>
				<control type="label">
					<width>90</width>
					<height>90</height>
					<font>IconWeather</font>
					<label>$PARAM[icon]</label>
				</control>
				<control type="group">
					<height>90</height>
					<control type="label">
						<width>auto</width>
						<height>60</height>
						<font>font15</font>
						<label>$PARAM[label]</label>
					</control>
					<control type="label">
						<top>50</top>
						<width>auto</width>
						<height>30</height>
						<font>font13</font>
						<label>$PARAM[caption]</label>
					</control>
				</control>
			</control>
		</definition>
	</include>
	<include name="WeatherDayItem">
		<definition>
			<item>
				<property name="LongDay">$INFO[Window(Weather).Property(Daily.$PARAM[day].LongDay)]</property>
				<property name="Title">$INFO[Window(Weather).Property(Daily.$PARAM[day].Title)]</property>
				<property name="ShortDay">$INFO[Window(Weather).Property(Daily.$PARAM[day].ShortDay)]</property>
				<property name="Outlook">$INFO[Window(Weather).Property(Daily.$PARAM[day].Outlook)]</property>
				<property name="FanartCode">$INFO[Window(Weather).Property(Daily.$PARAM[day].FanartCode)]</property>
				<property name="HighTemperature">$INFO[Window(Weather).Property(Daily.$PARAM[day].HighTemperature)]</property>
				<property name="LowTemperature">$INFO[Window(Weather).Property(Daily.$PARAM[day].LowTemperature)]</property>
				<property name="Precipitation">$INFO[Window(Weather).Property(Daily.$PARAM[day].Precipitation)]</property>
				<property name="ChancePrecipitation">$INFO[Window(Weather).Property(Daily.$PARAM[day].ChancePrecipitation)]</property>
				<property name="WindSpeed">$INFO[Window(Weather).Property(Daily.$PARAM[day].WindSpeed)]</property>
				<property name="WindDirection">$INFO[Window(Weather).Property(Daily.$PARAM[day].WindDirection)]</property>
				<visible>!String.IsEmpty(Window(Weather).Property(Daily.$PARAM[day].LongDay)) | !String.IsEmpty(Window(Weather).Property(Daily.$PARAM[day].Title)) | !String.IsEmpty(Window(Weather).Property(Daily.$PARAM[day].ShortDay))</visible>
			</item>
		</definition>
	</include>
