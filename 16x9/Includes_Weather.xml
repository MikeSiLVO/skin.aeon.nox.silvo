	<include name="WeatherTempBar">
		<definition>
			<control type="progress">
				<left>3</left>
				<top>368</top>
				<width>64</width>
				<height>16</height>
				<texturebg>colors/blank.png</texturebg>
				<midtexture colordiffuse="$PARAM[color]">colors/white.png</midtexture>
				<info>ListItem.Property(Temperature.Scaled)</info>
				<visible>$PARAM[visible]</visible>
				<animation type="Conditional" condition="true">
					<effect type="rotate" end="90" center="auto" />
					<effect type="zoom" end="344,100" center="auto" />
				</animation>
			</control>
		</definition>
	</include>
