	<include name="WeatherHourLabel">
		<param name="visible" default="true" />
		<definition>
			<control type="label">
				<top>$PARAM[top]</top>
				<width>130</width>
				<height>$PARAM[height]</height>
				<font>$PARAM[font]</font>
				<label>$PARAM[label]</label>
				<visible>Integer.IsOdd(ListItem.CurrentItem) + Integer.IsEqual(ListItem.CurrentItem,1) + $PARAM[visible]</visible>
			</control>
			<control type="label">
				<left>-60</left>
				<top>$PARAM[top]</top>
				<width>130</width>
				<height>$PARAM[height]</height>
				<align>right</align>
				<font>$PARAM[font]</font>
				<label>$PARAM[label]</label>
				<visible>Integer.IsOdd(ListItem.CurrentItem) + Integer.IsEqual(ListItem.CurrentItem,Container(9100).NumItems) + !Integer.IsEqual(ListItem.CurrentItem,1) + $PARAM[visible]</visible>
			</control>
			<control type="label">
				<left>-30</left>
				<top>$PARAM[top]</top>
				<width>130</width>
				<height>$PARAM[height]</height>
				<align>center</align>
				<font>$PARAM[font]</font>
				<label>$PARAM[label]</label>
				<visible>Integer.IsOdd(ListItem.CurrentItem) + !Integer.IsEqual(ListItem.CurrentItem,1) + !Integer.IsEqual(ListItem.CurrentItem,Container(9100).NumItems) + $PARAM[visible]</visible>
